{
  "pkg": "energycurve",
  "globalName": "EnergyCurve",
  "projectId": "52bbfc3f-24d6-4126-84be-6d92fc84bad9",
  "shape": "package",
  "srcDir": "components",
  "tsconfig": "./.design-sync/tsconfig.build.json",
  "cssEntry": ".design-sync/.cache/tailwind.css",
  "buildCmd": "node .design-sync/build-css.mjs",
  "readmeHeader": ".design-sync/conventions.md",
  "extraFonts": [".design-sync/fonts/fonts.css"],
  "guidelinesGlob": [],
  "overrides": {
    "Toast": { "cardMode": "single", "viewport": "480x240" },
