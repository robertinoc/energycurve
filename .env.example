# WorkOS AuthKit
# Local development values should point to WorkOS Staging and localhost.
# Vercel Production should use WorkOS Production and the deployed callback URL.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3010/auth/callback

# Supabase Postgres
# Prefer a dedicated Supabase project for local/dev and another for production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Configure the default WorkOS Logout URI in the WorkOS dashboard to:
# http://localhost:3010/

# PostHog product analytics (optional — analytics no-op when unset)
# The project API key is public by design; it feeds both the browser SDK
# and the server-side client.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Auth hardening (optional)
# Flip to "true" once WorkOS verification emails are confirmed working:
# signups then require a 6-digit code before a session is created.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Smart ordering (optional — required for Claude-powered reorder on the
# analysis screen). Server-only: the key never reaches the client. Without
# it, /api/playlists/:id/smart-order falls back to the local heuristic
# (ascending energy + two breathers) and the UI says so.
# Get a key at https://console.anthropic.com/ -> API keys.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
# SMART_ORDER_MODEL=claude-opus-5

# Transactional email via Resend (optional — required for password reset)
# Without these, /forgot-password shows an honest "not available" state.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Backstage admin panel (backstage.energycurve.app)
# Comma-separated emails allowed into /backstage. Falls back to the owner
# account when unset.
BACKSTAGE_ADMIN_EMAILS=robertinoc@gmail.com
# Personal API Key (read scope) + numeric project id for the live PostHog
# summary. Server-only — NOT the public NEXT_PUBLIC_POSTHOG_KEY.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# POSTHOG_API_HOST=https://us.posthog.com
# Comma-separated PostHog dashboard embed URLs (Share -> Embed on each one).
BACKSTAGE_POSTHOG_EMBED_URLS=
# Production only: share the session cookie with the backstage subdomain.
# WORKOS_COOKIE_DOMAIN=.energycurve.app

# --- SEO (optional) ---
# Token from Google Search Console > Add property > HTML tag verification.
# When set, the layout renders <meta name="google-site-verification">.
GOOGLE_SITE_VERIFICATION=

# --- Billing / Stripe (optional) ---
# Billing degrades gracefully: with these unset the app runs exactly as before
# and every /api/billing route answers 503. Full runbook in docs/billing.md.
# Stripe is linked to the StageLink LLC entity, so charges appear as
# "StageLink LLC" — that's stated up front on the landing and /pricing.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in the Stripe dashboard (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Price ids (price_…) for the four purchasable combinations. At least one is
# required for checkout to be offered at all.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_PLUS_MONTHLY=
STRIPE_PRICE_PRO_PLUS_YEARLY=
