# WorkOS AuthKit
# Local development values should point to WorkOS Staging and localhost.
# Vercel Production should use WorkOS Production and the deployed callback URL.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3010/auth/callback

# Supabase Postgres
# Prefer a dedicated Supabase project for local/dev and another for production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Configure the default WorkOS Logout URI in the WorkOS dashboard to:
# http://localhost:3010/

# PostHog product analytics (optional — analytics no-op when unset)
# The project API key is public by design; it feeds both the browser SDK
# and the server-side client.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Auth hardening (optional)
# Flip to "true" once WorkOS verification emails are confirmed working:
# signups then require a 6-digit code before a session is created.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Transactional email via Resend (optional — required for password reset)
# Without these, /forgot-password shows an honest "not available" state.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
